<%
  function deterministicMaterial(seed) {
    seed = String(seed || '');
    var hash = 0;
    for (var i = 0; i < seed.length; i++) {
      hash = ((hash << 5) - hash + seed.charCodeAt(i)) | 0;
    }
    return '/images/random/material-' + (Math.abs(hash % 19) + 1) + '.png';
  }

  function getArchiveThumbnail(post) {
    return post.thumbnail || deterministicMaterial(post.uuid || post.path || post.title);
  }
%>
<% if (page.current === 1 && is_home() && theme.notice) { %>
  <article class="mdui-card mdui-m-b-5 mdui-hoverable">
    <div class="mdui-card-content mdui-typo mdui-ripple" id="notice-container">
      <i class="mdui-icon material-icons mdui-text-color-deep-orange" translate="no">announcement</i> 
      
      <% if (Array.isArray(theme.notice)) { %>
        <% var initialNotice = theme.notice.length ? theme.notice[0] : ''; %>
        <span id="random-notice" aria-live="polite"><%- initialNotice %></span>
        <script data-pjax>
          (function() {
            var notices = <%- JSON.stringify(theme.notice) %>;
            var currentIndex = -1;
            var typingTimer = null;

            function randomIndex(excludeIndex) {
              if (!Array.isArray(notices) || !notices.length) return -1;
              if (notices.length === 1) return 0;

              var nextIndex = excludeIndex;
              while (nextIndex === excludeIndex) {
                nextIndex = Math.floor(Math.random() * notices.length);
              }
              return nextIndex;
            }

            function plainTextFromHtml(html) {
              var scratch = document.createElement('div');
              scratch.innerHTML = html || '';
              return scratch.textContent || scratch.innerText || '';
            }

            function stopTyping(noticeElement) {
              if (typingTimer) {
                clearTimeout(typingTimer);
                typingTimer = null;
              }
              if (noticeElement) noticeElement.classList.remove('notice-typing');
            }

            function renderNotice(noticeElement, html, animate) {
              stopTyping(noticeElement);

              var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if (!animate || reduceMotion) {
                noticeElement.innerHTML = html || '';
                return;
              }

              var text = plainTextFromHtml(html);
              if (!text) {
                noticeElement.innerHTML = html || '';
                return;
              }

              var index = 0;
              noticeElement.textContent = '';
              noticeElement.classList.add('notice-typing');

              function typeNext() {
                if (index >= text.length) {
                  noticeElement.innerHTML = html || '';
                  stopTyping(noticeElement);
                  return;
                }

                noticeElement.textContent += text.charAt(index);
                index += 1;
                typingTimer = setTimeout(typeNext, 25 + Math.random() * 72);
              }

              typeNext();
            }

            window.initNoticeSystem = function() {
              var container = document.getElementById('notice-container');
              var noticeElement = document.getElementById('random-notice');
              var isHome = window.location.pathname === '/' || window.location.pathname === '/index.html';
              if (!isHome || !container || !noticeElement || !Array.isArray(notices) || !notices.length) return;

              if (!container.dataset.noticeReady) {
                container.dataset.noticeReady = '1';
                currentIndex = randomIndex(-1);
                renderNotice(noticeElement, notices[currentIndex], true);
              }

              if (!container.dataset.noticeBound) {
                container.dataset.noticeBound = '1';
                container.addEventListener('click', function(event) {
                  var target = event.target && event.target.nodeType === 1 ? event.target : event.target.parentElement;
                  if (target && target.closest && target.closest('a')) return;
                  if (notices.length <= 1) return;
                  //currentIndex = (currentIndex + 1) % notices.length;
                  currentIndex = randomIndex(currentIndex);
                  noticeElement.classList.add('notice-fade-out');
                  setTimeout(function() {
                    noticeElement.classList.remove('notice-fade-out');
                    renderNotice(noticeElement, notices[currentIndex], true);
                  }, 120);
                });
              }
            };

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', window.initNoticeSystem);
            } else {
              window.initNoticeSystem();
            }
          
          })();
          </script>
        <style data-pjax>
          /* Keep the notice inline but preserve fade-out via opacity transition. */
          #random-notice { display:inline; min-height:1.45em; line-height:1.45; vertical-align:middle; transition:opacity .18s ease; }
          /* Only fade via opacity so inline layout is preserved (no transform). */
          #random-notice.notice-fade-out { opacity:0; }
          #random-notice.notice-typing::after { content:'_'; display:inline; margin-left:2px; opacity:.7; animation:notice-caret 1s steps(1) infinite; overflow:hidden; }
          @keyframes notice-caret { 50% { opacity:0; } }
          @media (prefers-reduced-motion: reduce) {
            #random-notice.notice-typing::after { content:''; animation:none; }
          }
        </style>
      <% } else { %>
        <%= theme.notice %>
      <% } %>
  </article>
<% } %>
<% if (is_archive()) { %>
  <div class="mdui-chip mdui-m-b-3">
    <span class="mdui-chip-icon mdui-color-theme-accent"><i class="mdui-icon material-icons" translate="no">place</i></span>
    <span class="mdui-chip-title"><%= __('archive') %>：<%= page.year %>/<%= page.month %></span>
  </div>
<% } %>
<% if (is_category()) { %>
  <div class="mdui-chip mdui-m-b-3">
    <span class="mdui-chip-icon mdui-color-theme-accent"><i class="mdui-icon material-icons" translate="no">place</i></span>
    <span class="mdui-chip-title"><%= __('category') %>：<%= page.category %></span>
  </div>
<% } %>
<% if (is_tag()) { %>
  <div class="mdui-chip mdui-m-b-3">
    <span class="mdui-chip-icon mdui-color-theme-accent"><i class="mdui-icon material-icons" translate="no">place</i></span>
    <span class="mdui-chip-title"><%= __('tag') %>：<%= page.tag %></span>
  </div>
<% } %>
<% var postCardIndex = 0; %>
<% page.posts.each(function (post) { %>
  <% postCardIndex++; %>
  <% var coverImage = getArchiveThumbnail(post); %>
  <% var isPrimaryCard = is_home() && page.current === 1 && postCardIndex === 1; %>
  <article class="mdui-card mdui-m-b-5 mdui-hoverable">
    <a href="<%- url_for(post.link || post.path) %>"<% if (post.link) { %> target="_blank"<% } %>>
      <header class="mdui-card-media mdui-ripple">
        <img src="<%- url_for(coverImage) %>" width="1280" height="720" <% if (isPrimaryCard) { %> fetchpriority="high"<% } else { %>loading="lazy"<% } %> decoding="async" style="max-height: 240px; width: 100%; aspect-ratio: 16 / 9; object-fit: cover;" alt="<%= post.title %>">
        <div class="mdui-card-media-covered">
          <div class="mdui-card-primary">
            <div class="mdui-card-primary-title"><%= post.title %></div>
            <div class="mdui-card-primary-subtitle"><i class="mdui-icon material-icons" translate="no">today</i> <%- date(post.date) %> / <i class="mdui-icon material-icons" translate="no">person</i> <%= post.author || config.author %></div>
          </div>
        </div>
        <% if (post.sticky || post.top) { %>
          <div class="mdui-card-menu">
            <button class="mdui-btn mdui-btn-icon mdui-text-color-white"><i class="mdui-icon material-icons" translate="no">flag</i></button>
          </div>
        <% } %>
      </header>
    </a>

      <a href="<%- url_for(post.link || post.path) %>"<% if (post.link) { %> target="_blank"<% } %> class="mdui-card-content mdui-typo mdui-ripple" style="display:block;text-decoration:none;color:inherit;">
        <% if (post.excerpt) { %>
          <%- strip_html(post.excerpt) %>...
          <span style="float: right; display: inline-flex; align-items: center; text-align: right;">
            <i class="mdui-icon material-icons" style="font-size:1em; vertical-align:middle; line-height:1;" translate="no">navigate_next</i>
            <%= __('more') %>
          </span>
        <% } else { %>
          <%- strip_html(truncate(post.content, {length: 120})) %>... 
            <span style="float: right; display: inline-flex; align-items: center; text-align: right;">
            <i class="mdui-icon material-icons" style="font-size:1em; vertical-align:middle; line-height:1;" translate="no">navigate_next</i>
            <%= __('more') %>
          </span>
        <% } %>
      </a>
    
    <!-- <div class="mdui-text-center">
       <a href="<%- url_for(post.link || post.path) %>"<% if (post.link) { %> target="_blank"<% } %> class="mdui-btn mdui-btn-icon mdui-ripple" mdui-tooltip="{content: '<%= __('more') %>'}"><i class="mdui-icon material-icons" translate="no">arrow_forward</i></a> 
    </div> -->
    <footer class="mdui-card-actions">
      <% if (post.categories && post.categories.length) { %>
        <%- list_categories(post.categories, {show_count: false, style: 'none', separator: '', class: 'mdui-ripple article_categories'}) %>
      <% } %>
      <% if (post.tags && post.tags.length) { %>
        <%- list_tags(post.tags, {show_count: false, style: 'none', separator: '', class: {a: 'mdui-ripple article_tags-link'}}) %>
      <% } %>
    </footer>
  </article>
<% }) %>
<% if (page.total > 1) { %>
  <nav id="paginator">
    <%- paginator({
      prev_text: '<button aria-label="prev" class="mdui-btn mdui-btn-raised mdui-btn-icon mdui-color-theme-accent mdui-ripple"><i class="mdui-icon material-icons" translate="no">arrow_back</i></button>',
      next_text: '<button aria-label="next" class="mdui-btn mdui-btn-raised mdui-btn-icon mdui-color-theme-accent mdui-ripple"><i class="mdui-icon material-icons" translate="no">arrow_forward</i></button>',
      escape: false,
      space: ''
    }) %>
  </nav>
<% } %>
