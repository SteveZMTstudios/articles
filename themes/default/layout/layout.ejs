<!DOCTYPE html>
<html lang="<%= page.lang %>">
<%- partial('_partial/head') %>
<body class="mdui-appbar-with-toolbar mdui-theme-primary-<%= theme.theme_color.primary || 'indigo' %> mdui-theme-accent-<%= theme.theme_color.accent || 'pink' %>">
  <a id="skip-to-content" href="#main" class="mdui-sr-only" aria-label="<%= __('skip_to_content') %>"><%= __('skip_to_content') %></a>
  <script>
    window.__SITE_ASSET_CONFIG__ = {
      analyticsId: '<%= theme.analytics.google_site_id || "" %>',
      busuanziSrc: '<%= (theme.busuanzi.site || theme.busuanzi.page) ? theme.busuanzi.busuanzi_js : "" %>',
      gitalkCss: '//gcore.jsdelivr.net/npm/gitalk@1/dist/gitalk.css',
      gitalkSrc: '<%= theme.comment && theme.comment.use === "gitalk" ? (theme.comment.gitalk_js || "//gcore.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js") : "" %>',
      gitalkBridgeSrc: '<%= theme.comment && theme.comment.use === "gitalk" ? "//sharepoint.cf.stevezmt.top/js/3rd-party/gitalk-cn.min.js" : "" %>'
    };
  </script>
  <script>
    var dark = localStorage.getItem("mdui-theme-layout-dark");
    var light = localStorage.getItem("mdui-theme-layout-light");
    if (dark || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches && !light)) {
      document.getElementsByTagName("body")[0].className+=" mdui-theme-layout-dark";
    }
  </script>
  <script>var a=localStorage.getItem("mdui-drawer-close");if(!a){document.getElementsByTagName("body")[0].className+=" mdui-drawer-body-left"};</script>
  <%- partial('_partial/header', null, {cache: !config.relative_link}) %>
  <%
    var pageType = 'generic';
    if (is_home()) pageType = 'home';
    else if (is_post()) pageType = 'post';
    else if (page.photos && page.photos.length) pageType = 'gallery';
    else if (is_archive() || is_category() || is_tag()) pageType = 'listing';
  %>
  <main
    id="main"
    class="mdui-m-t-5 pjax-in"
    data-page-type="<%= pageType %>"
    data-is-home="<%= is_home() ? '1' : '0' %>"
    data-is-post="<%= is_post() ? '1' : '0' %>"
    data-has-comments="<%= (is_post() && page.comments && theme.comment.use) ? '1' : '0' %>"
    data-has-toc="<%= (is_post() && page.toc) ? '1' : '0' %>"
    data-search-resource="<%= theme.search && theme.search.use === 'plugin' ? url_for(theme.search.path) : '' %>"
  ><%- body %></main>
  <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
  <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
  <div id="gotop-container" class="mdui-fab-fixed mdui-fab-hide">
    <button id="gotop" class="mdui-fab mdui-color-theme-accent mdui-ripple"><i class="mdui-icon material-icons" translate="no">arrow_upward</i></button>
    <svg class="progress-ring" width="60" height="60">
      <circle class="progress-ring__circle mdui-text-color-theme-a100" stroke="currentColor" stroke-width="4" fill="transparent" r="26" cx="30" cy="30"/>
    </svg>
  </div>
  <!-- <%- js(['js/mdui', 'js/script', 'js/lightbox', 'js/pjax']) %> -->
   <script src="<%= theme.mdui_cdn && theme.mdui_cdn.js && theme.mdui_cdn.js.url ? theme.mdui_cdn.js.url : '/js/mdui.js' %>"
        <% if (theme.mdui_cdn && theme.mdui_cdn.js && theme.mdui_cdn.js.crossorigin) { %>crossorigin="<%= theme.mdui_cdn && theme.mdui_cdn.js && theme.mdui_cdn.js.crossorigin ? theme.mdui_cdn.js.crossorigin : '' %>"<% } %>
        <% if (theme.mdui_cdn && theme.mdui_cdn.js && theme.mdui_cdn.js.integrity) { %>integrity="<%= theme.mdui_cdn && theme.mdui_cdn.js && theme.mdui_cdn.js.integrity ? theme.mdui_cdn.js.integrity : '' %>"<% } %>
        onerror="this.onerror=null; this.src='/js/mdui.js';"></script>
<script>
  // fallback
  if (typeof window.mdui === 'undefined') {
    var script = document.createElement('script');
    script.src = '/js/mdui.js';
    document.body.appendChild(script);
  }
</script>
<%- js(['js/script', 'js/lightbox', 'js/pjax']) %>
  <script>
    // Remove initial animation class
    setTimeout(function() {
      var main = document.getElementById('main');
      if (main) main.classList.remove('pjax-in');
    }, 300);
  </script>
  <%- js('custom') %>
  <%- js('js/sw-update') %>
  <script>
  (function(){
    if (!('serviceWorker' in navigator)) return;
    try {
      navigator.serviceWorker.getRegistrations().then(function(regs){
        var rootScope = location.origin + '/';
        var hasRoot = regs.some(function(r){ return r.scope === rootScope; });
        if (!hasRoot) {
          navigator.serviceWorker.register('/service-worker.js', {scope: '/'}).then(function(reg){
            console.log('[sw-fix] registered root service-worker', reg.scope);
          }).catch(function(err){
            console.warn('[sw-fix] root register failed', err);
          });
        }
      }).catch(function(e){ console.warn('[sw-fix] getRegistrations failed', e); });
    } catch(e) { console.warn('[sw-fix] unexpected', e); }
  })();
  </script>
</body>
</html>
