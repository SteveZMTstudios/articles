/service-worker.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/workbox-*.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/atom.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/feed.xsl
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=0, must-revalidate
